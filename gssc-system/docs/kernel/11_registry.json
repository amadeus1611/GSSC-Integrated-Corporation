  "classification_workflow": [
    "exact filename",
    "inspect content/fingerprint",
    "compare role/status",
    "clarify only if treatment changes materially",
    "route to doctrine and engine"
  ],
  "supersession": [
    "register new master",
    "move prior master to legacy",
    "record relationship",
    "reroute derivatives",
    "deprecate only when no active lineage use remains"
  ],
  "verification_triggers": [
    "kernel doctrine change",
    "master structural change",
    "new same-role master",
    "user-reported drift",
    "asset or contact update"
  ],
  "conflict_rules": [
    "The latest verified government identity source supplied by the user overrides older government certificates, profiles, drafts, and memories.",
    "Exact duplicate filenames must be disambiguated by content hash before promotion.",
    "A filename containing FINAL does not establish execution, counsel review, notarization, or authoritative status by itself.",
    "A filename version and embedded package marker may differ; record both and do not rename solely from an internal marker.",
    "An existing legal candidate replaces a planned role but remains review_pending until its stated gates are satisfied.",
    "The highest retrieved semantic version is the latest candidate only; it does not become authoritative without its legal promotion gates."
  ],
  "planned_role_rule": "A planned role carries planned_since and revisit_by. An open-ended planned role is indistinguishable from an abandoned one and will sit in the registry forever without anyone noticing it is still open."
}